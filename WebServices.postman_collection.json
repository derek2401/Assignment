      "name": "Success - getSingleProduct",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Convert response body to JSON",
              "const responseJSON = pm.response.json();",
              "",
              "// Check if request was successful",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Make sure it returns a product id",
              "pm.test(\"Return ProductID\", function () {",
              "    pm.expect(responseJSON).to.have.property(\"ProductID\");",
              "});",
              "",
              "// Check if returned product id matches the one searched for",
              "pm.test(\"Returned ProductID matches the searched one\", function () {",
              "    pm.expect(responseJSON.ProductID).to.equal(1005);",
              "});",
              "",
              "// Check that request returns all expected fields",
              "pm.test(\"Response contains all expected fields\", function () {",
              "    pm.expect(responseJSON).to.have.all.keys(\"ProductID\", \"Name\", \"UnitPrice\", \"StockQuantity\", \"Description\");",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
