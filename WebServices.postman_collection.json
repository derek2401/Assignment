    {
      "name": "Success - convert",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Convert response body to JSON",
              "const responseJSON = pm.response.json();",
              "",
              "// Check if request was successful",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Check if the response contains the expected data",
              "// Check for productID",
              "pm.test(\"Response contains productID\", function () {",
              "    pm.expect(responseJSON).to.have.property('ProductID');",
              "    });",
              "// Check for productName",
              "pm.test(\"Response contains productName\", function () {",
              "    pm.expect(responseJSON).to.have.property('Name');",
              "});",
              "// Check for USD price",
              "pm.test(\"Response contains USD price\", function () {",
              "    pm.expect(responseJSON).to.have.property('USDPrice');",
              "    pm.expect(responseJSON.USDPrice).to.be.a('number');",
              "});",
              "// Check for EUR rate",
              "pm.test(\"Response contains EUR rate\", function () {",
              "    pm.expect(responseJSON).to.have.property('EURRate');",
              "    pm.expect(responseJSON.EURRate).to.be.a('number');",
              "});",
              "// Check for price converted to EUR",
              "pm.test(\"Response contains converted price in EUR\", function () {",
              "    pm.expect(responseJSON).to.have.property('EURConverted');",
              "    pm.expect(responseJSON.EURConverted).to.be.a('number');",
              "});",
              "",
